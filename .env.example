# Required: TeamSnap OAuth credentials
TEAMSNAP_CLIENT_ID=your-client-id-here
TEAMSNAP_CLIENT_SECRET=your-client-secret-here

# Optional: Override the local OAuth callback port (default: 8374)
# TEAMSNAP_CALLBACK_PORT=8374

# Optional: Override redirect URI (e.g., for tunnel URLs)
# TEAMSNAP_REDIRECT_URI=https://your-tunnel-url/callback

# AWS deployment only: API Gateway endpoint
# TEAMSNAP_MCP_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/mcp
